# F-Zero GX (NTSC-U, GFZE01)
# Reference: docs/dtk/config.example.yml (from dtk-template) for every option.
object_base: orig/GFZE01
object: sys/main.dol
ldscript_template: config/GFZE01/ldscript.tpl
hash: 421c88106697d3275a3fc26fb7a01bf6d816b271
symbols: config/GFZE01/symbols.txt
splits: config/GFZE01/splits.txt
# 8 = CodeWarrior for GameCube 1.0+; revisit after M1 determines the exact compiler.
mw_comment_version: 8
quick_analysis: false
detect_objects: true
detect_strings: true
write_asm: true

# Function-boundary analysis stalls on a jump-table region here
# ("Overlapping functions 1:0x8006D1C4-1:0x8006D21C"). See docs/batches/m0.md.
skip_cfa_ranges:
- start: .text:0x8006D000
  end: .text:0x8006E200

# Every REL shipped on the disc plus main.rel, which prepare_orig.py derives
# from files/enemy_line/line__.bin (decrypt + LZ-decompress). Module ids are
# globally unique (1..18), so every module links against every other.
modules:
